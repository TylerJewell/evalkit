<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.akka.evalkit</groupId>
    <artifactId>evalkit-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>evalkit-core</name>
    <description>Scoring, outcomes and reporting, over the Akka ledger's interaction record.</description>

    <url>https://github.com/tylerjewell/evalkit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Tyler Jewell</name>
            <url>https://github.com/tylerjewell</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/tylerjewell/evalkit</url>
        <connection>scm:git:https://github.com/tylerjewell/evalkit.git</connection>
        <developerConnection>scm:git:git@github.com:tylerjewell/evalkit.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/tylerjewell/evalkit/issues</url>
    </issueManagement>

    <!--
      akka-javasdk supplies the evidence types. A scorer reads
      akka.javasdk.ledger.InteractionRecord and an evaluator extends
      akka.javasdk.evaluation.Evaluator, so a score this kit produced and a score
      read back from the ledger describe the same interaction. The types evalkit
      keeps are the ones holding an invariant the SDK does not enforce: Verdict
      pairs a 1-to-10 score with its Band, and RunOutcome carries NotReached,
      which no ledger record can represent.

      No parent. evalkit-akka inherits akka-javasdk-parent because its TestKit
      needs the build that supplies; this module declares the dependency and
      nothing else.
    -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <akka.sdk.version>3.6.0-59-7321c44b-dev-SNAPSHOT</akka.sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.akka</groupId>
            <artifactId>akka-javasdk</artifactId>
            <version>${akka.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
